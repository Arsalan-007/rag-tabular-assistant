# Copy to .env and adjust. Every value here has a sane default in src/config.py;
# .env only overrides. Nothing in here is required to run locally with Ollama.

# ─── Generator ────────────────────────────────────────────────────────────
# ollama  -> local, offline, no key   (default; needs `ollama serve` + a model)
# gemini  -> Google Gemini API        (used by the hosted demo)
GENERATOR=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Only needed when GENERATOR=gemini. Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Retrieval ───────────────────────────────────────────────────────────
# dense   -> bge-small vector search only
# hybrid  -> bge-small + BM25, fused with Reciprocal Rank Fusion  (default)
RETRIEVAL_MODE=hybrid

# Cross-encoder reranking of the fused candidates (biggest quality lever).
RERANK=true
RERANKER_MODEL=BAAI/bge-reranker-base
# On a memory-constrained host, swap for a tiny reranker or turn RERANK off:
#   RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

EMBED_MODEL=BAAI/bge-small-en-v1.5

FETCH_K=20        # candidates pulled from each retriever before fusion/rerank
TOP_K=5           # passages actually shown to the generator
RRF_K=60          # Reciprocal Rank Fusion smoothing constant
MIN_SIMILARITY=0.25   # below this top score, warn "no strong match in the corpus"
