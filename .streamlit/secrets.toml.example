# Streamlit Community Cloud: paste these into the app's Settings → Secrets.
# (Locally, prefer a .env file — see .env.example.)

GENERATOR = "gemini"
GEMINI_API_KEY = "your-key-here"        # https://aistudio.google.com/apikey
GEMINI_MODEL = "gemini-flash-lite-latest"

# Retrieval is fine at its defaults (hybrid + rerank). On the free CPU tier the
# cross-encoder adds ~2 s/query; set RERANK = "false" if that's too slow.
# RERANK = "true"
# RETRIEVAL_MODE = "hybrid"
