# Streamlit Community Cloud: paste these into the app's Settings → Secrets.
# (Locally, prefer a .env file — see .env.example. Never commit real values.)

GENERATOR      = "gemini"
GEMINI_API_KEY = "your-key-here"          # https://aistudio.google.com/apikey
GEMINI_MODEL   = "gemini-flash-lite-latest"

# The default reranker (BAAI/bge-reranker-base) needs ~1.1 GB of RAM and does
# NOT fit Streamlit's free tier. This small cross-encoder is ~90 MB and still a
# genuine reranker.
RERANKER_MODEL = "cross-encoder/ms-marco-MiniLM-L-6-v2"

# If the app still gets OOM-killed, drop reranking entirely. Dense-only
# retrieval still scores hit@5 0.950 / MRR 0.878 — see eval/results.md.
# RERANK = "false"

# Retrieval defaults (hybrid, no query rewrite) are fine as-is.
# RETRIEVAL_MODE = "hybrid"
