# PDFs are re-downloadable from arXiv on `make ingest`; don't bloat the repo.
data/pdfs/*.pdf

# The vector store ships as data/chroma.tar.gz (Git LFS); the extracted
# directory is a runtime artifact (Chroma mutates its SQLite on every query).
data/chroma/

# Environments
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local config
.env
.streamlit/secrets.toml

.DS_Store
